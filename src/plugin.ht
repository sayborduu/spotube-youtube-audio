import "module:std" as std
import "module:spotube_plugin" as spotube_plugin

import { AudioSourceEndpoint } from './segments/audio_source.ht'
import { AuthEndpoint } from './segments/auth.ht'
import { CorePlugin } from './segments/core.ht'

var HttpClient = std.HttpClient
var HttpBaseOptions = std.HttpBaseOptions
var LocalStorage = spotube_plugin.LocalStorage

class YouTubeAudioSourcePlugin {
  var audioSource: AudioSourceEndpoint
  var auth: AuthEndpoint
  var core: CorePlugin
  var api: HttpClient

  construct (){
    api = HttpClient(
      HttpBaseOptions(
        baseUrl: "https://example.com"
      )
    )

    audioSource = AudioSourceEndpoint(api, LocalStorage())
    auth = AuthEndpoint()
    core = CorePlugin(api)

    auth.authStateStream.listen((event) {
      // Auth state changed
    })
  }
}

export { YouTubeAudioSourcePlugin }
