import "module:spotube_plugin" as spotube
import "module:std" as std

var LocalStorage = spotube.LocalStorage
var StreamController = std.StreamController
var Stream = std.Stream
var StreamSubscription = std.StreamSubscription

class AuthEndpoint {
  var _isAuthenticated: bool
  final controller: StreamController

  get authStateStream -> Stream => controller.stream

  construct (){
    _isAuthenticated = false
    controller = StreamController.broadcast()
    initializeFromLocalStorage()
  }

  fun initializeFromLocalStorage() {
    LocalStorage.getString("youtube_audio_source.rapidapi_key").then((key) {
      if (key != null && key.isNotEmpty) {
        _isAuthenticated = true
        controller.add({ type: "recovered" }.toJson())
      }
    })
  }

  fun isAuthenticated() -> bool {
    return _isAuthenticated
  }

  fun authenticate() -> Future {
    return spotube.SpotubeForm.show(
      "RapidAPI Authentication",
      [
        {
          objectType: "text",
          text: "Enter your RapidAPI key to enable MP3 downloads via the youtube-mp3-download API."
        }.toJson(),
        {
          objectType: "input",
          id: "rapidapi_key",
          variant: "password",
          placeholder: "x-rapidapi-key",
          required: true
        }.toJson()
      ]
    ).then((result) {
      if (result != null && result.isNotEmpty) {
        var keyField = result.firstWhere((f) => f["id"] == "rapidapi_key", orElse: () => null)
        if (keyField != null) {
          var key = keyField["value"]
          if (key != null && key.isNotEmpty) {
            LocalStorage.setString("youtube_audio_source.rapidapi_key", key)
            _isAuthenticated = true
            controller.add({ type: "login" }.toJson())
          }
        }
      }
    })
  }

  fun logout() {
    _isAuthenticated = false
    LocalStorage.remove("youtube_audio_source.rapidapi_key")
    controller.add({ type: "logout" }.toJson())
  }
}

export { AuthEndpoint }
