import "module:spotube_plugin" as spotube_plugin
import "module:std" as std
import { ExternalApiSource } from './external_api_source.ht'

var YouTubeEngine = spotube_plugin.YouTubeEngine
var LocalStorage = spotube_plugin.LocalStorage
var HttpClient = std.HttpClient

class Converter {
  static fun toSpotubeMatchObject(res: List) -> List<Map> {
    return res.map((d){
      return {
        "id": d["id"],
        "title": d["title"],
        "artists": [d["author"]],
        "duration": d["duration"],
        "thumbnail": d["thumbnail"],
        "externalUri": "https://youtube.com/watch?v=${d["id"]}",
      }.toJson()
    }).toList()
  }
}


class AudioSourceEndpoint {
  var yt: YouTubeEngine
  var _externalApi: ExternalApiSource
  var _api: HttpClient

  construct (api: HttpClient, storage: LocalStorage) {
    yt = YouTubeEngine()
    _api = api
    _externalApi = ExternalApiSource(storage)
  }

  get supportedPresets -> List {
    return [
      { type: "lossy", name: "mp4", qualities: [ { bitrate: 256000 }, { bitrate: 128000 }, { bitrate: 96000 }, { bitrate: 44000 } ] }.toJson(),
      { type: "lossy", name: "webm", qualities: [ { bitrate: 256000 }, { bitrate: 128000 }, { bitrate: 96000 }, { bitrate: 44000 } ] }.toJson(),
      { type: "lossy", name: "mp3", qualities: [ { bitrate: 128000 } ] }.toJson(),
    ]
  }

  fun matches(track: Map) -> List {
    final artists = track["artists"].map((a)=> a["name"]).join(", ")
    final hasISRC = track["isrc"] != null && track["isrc"].isNotEmpty;
    return yt.search(
      hasISRC ? track["isrc"] : "${track["name"]} ${artists}"
    ).then((res){
      if(res.isEmpty && hasISRC) {
        return yt.search(
          "${track["name"]} ${artists}"
        ).then((res)=> Converter.toSpotubeMatchObject(res))
      }
      return Converter.toSpotubeMatchObject(res)
    })
  }

  fun streams(match: Map) -> List {
    var videoId = match["id"]
    return _externalApi.fetchStreams(_api, videoId).then((apiStreams) {
      if (apiStreams.isNotEmpty) {
        return apiStreams
      }
      return yt.streamManifest(videoId).then((manifest) {
        return manifest.map((stream) {
          var url = stream["url"]
          if (url.startsWith("http://0.0.0.0:")) {
            url = url.replaceFirst("0.0.0.0", "127.0.0.1")
          }
          var container = stream["container"]
          var codec = container == "webm" ? "opus" : "aac"
          return {
            "url": url,
            "container": container,
            "type": "lossy",
            "codec": codec,
            "bitrate": stream["bitrate"],
          }.toJson()
        }).toList()
      })
    })
  }
}

export { AudioSourceEndpoint }
